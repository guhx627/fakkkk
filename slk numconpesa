-- =======================
-- Lógica: Sofá do Void
-- =======================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local SofaTargetName = ""
local SofaActive = false
local SofaConn -- heartbeat connection
local SeatObj -- seat we spawn/follow with
local SavedCF -- player original position

local function CleanupSofa()
    SofaActive = false
    if SofaConn then SofaConn:Disconnect() SofaConn = nil end
    if SeatObj and SeatObj.Parent then SeatObj:Destroy() end
    SeatObj = nil
end

local function Notify(msg, dur)
    pcall(function()
        game.StarterGui:SetCore("SendNotification", {
            Title = "Cleather Hub",
            Text = msg,
            Duration = dur or 3
        })
    end)
end

local function GetHRP(char)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function EnsureSeat()
    if SeatObj and SeatObj.Parent then return SeatObj end
    local seat = Instance.new("Seat")
    seat.Name = "CleatherSeat"
    seat.Anchored = true
    seat.CanCollide = true
    seat.Transparency = 0.2
    seat.TopSurface = Enum.SurfaceType.Smooth
    seat.BottomSurface = Enum.SurfaceType.Smooth
    seat.Parent = workspace
    SeatObj = seat
    return seat
end

local function TeleportHRPSafe(char, cf)
    local hrp = GetHRP(char)
    if hrp then
        hrp.CFrame = cf
    end
end

local function ToggleSofaVoid(targetName)
    if SofaActive then
        CleanupSofa()
        Notify("Sofá do Void desativado.")
        return
    end

    local target = Players:FindFirstChild(targetName or "")
    if not target or not target.Character or not GetHRP(target.Character) then
        Notify("Alvo não encontrado ou sem personagem.")
        return
    end

    local myChar = LocalPlayer.Character
    if not myChar or not GetHRP(myChar) then
        Notify("Seu personagem não está pronto.")
        return
    end

    SavedCF = GetHRP(myChar).CFrame
    SofaActive = true
    Notify("Sofá do Void ativado para: "..target.Name)

    local seat = EnsureSeat()

    -- Loop de perseguição + detecção de sentar
    SofaConn = RunService.Heartbeat:Connect(function()
        if not SofaActive then return end

        local tChar = target.Character
        local tHRP = GetHRP(tChar)
        local mChar = LocalPlayer.Character
        local mHRP = GetHRP(mChar)

        if not tChar or not tHRP or not mChar or not mHRP then
            CleanupSofa()
            Notify("Perdeu o alvo ou você resetou.")
            return
        end

        -- Mantém o assento grudado no alvo (atrás/um pouco abaixo)
        local followOffset = CFrame.new(0, -1, 0.8) -- ajuste fino pra facilitar o "sit"
        seat.CFrame = tHRP.CFrame * followOffset

        -- Te mantém junto do assento
        mHRP.CFrame = seat.CFrame * CFrame.new(0, 2.5, -2)

        -- Verifica se o alvo sentou (Seat.Occupant) ou SeatWeld
        local occupant = seat.Occupant
        local seatedTarget = (occupant and occupant.Parent == tChar)

        local hasSeatWeld = false
        if seat:FindFirstChild("SeatWeld") then
            local sw = seat.SeatWeld
            if sw.Part1 and sw.Part1.Parent == tChar then
                hasSeatWeld = true
            end
        end

        if seatedTarget or hasSeatWeld then
            -- Leva tudo pro void
            local voidCF = CFrame.new(0, -800, 0)
            seat.CFrame = voidCF
            mHRP.CFrame = voidCF * CFrame.new(0, 3, 0)
            -- pequena espera
            task.wait(1.0)
            -- Volta você pro lugar original
            TeleportHRPSafe(mChar, SavedCF)
            CleanupSofa()
            Notify("Alvo despachado pro void 😈")
        end
    end)
end

