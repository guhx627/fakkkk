local function BuildTrollTab()
    ClearContent()

    -- Input de Nick
    local NickBox = MakeTextBox("Nick do Alvo", "Digite o nick exato...", function(text)
        SofaTargetName = text or ""
    end)

    -- Ativar
    MakeButton("Sofá do Void (Ativar)", function()
        if SofaTargetName == "" then
            Notify("Digite o nick do alvo primeiro.")
            return
        end
        ToggleSofaVoid(SofaTargetName)
    end)

    -- Parar manualmente
    MakeButton("Parar Sofá do Void", function()
        if SofaActive then
            CleanupSofa()
            Notify("Sofá do Void desativado manualmente.")
        else
            Notify("A função não está ativa.")
        end
    end)

    -- Aviso
    MakeButton("Aviso de Teste", function()
        Notify("Cleather Hub online (Aba Troll).")
    end)
end

local function BuildVisualTab()
